# Local SQL Server example. Copy this file to .env.local and replace the values.
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_SERVER_DATABASE=PartMatchAI
SQL_SERVER_USER=sa
SQL_SERVER_PASSWORD=replace-with-a-strong-password
SQL_SERVER_TRUSTED_CONNECTION=false

# Local SQL Server often uses a self-signed certificate.
# In production, use ENCRYPT=true and TRUST_CERTIFICATE=false.
SQL_SERVER_ENCRYPT=false
SQL_SERVER_TRUST_CERTIFICATE=true

# Windows local-development alternative (no username or password required):
# SQL_SERVER_TRUSTED_CONNECTION=true
# SQL_SERVER_CONNECTION_STRING=Driver={ODBC Driver 17 for SQL Server};Server=localhost;Database=PartMatchAI;Trusted_Connection=Yes;Encrypt=No;TrustServerCertificate=Yes;
# If TCP is disabled, use: Server=np:\\.\pipe\sql\query

# Shared participating seller contact for the pilot (international phone format).
SELLER_CONTACT_NAME=
SELLER_CONTACT_PHONE=
